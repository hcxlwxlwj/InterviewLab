{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "noUnusedLocals": true
  },
  "include": ["code/**/*.ts", "code/**/*.tsx", "tests/**/*.ts", ".github/scripts/**/*.ts"],
  "exclude": ["node_modules", "**/.next", "**/next-env.d.ts"]
}
