{
  "name": "interviewlab",
  "private": true,
  "workspaces": [
    "code/frontend",
    "code/backend",
    "code/core_engine",
    "code/content"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @interviewlab/web",
    "build": "npm run build --workspace @interviewlab/web",
    "start": "npm run start --workspace @interviewlab/web",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "boundaries:check": "tsx scripts/check-boundaries.ts",
    "docs:check": "python .github/scripts/check_repository.py",
    "check": "npm run boundaries:check && npm run typecheck && npm run content:check && npm test && npm run docs:check",
    "format:code": "prettier --write \"code/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
