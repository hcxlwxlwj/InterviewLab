# Copy to .env at the repository root. These credentials are for local development only.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Server-side proxy target, loaded by Next.js config from this root .env.
BACKEND_ORIGIN=http://127.0.0.1:3001
# Authentication is opt-in; public content remains usable without a database.
AUTH_ENABLED=false
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
LOG_LEVEL=info
# Optional for the public API; mandatory for migrations and worker.
DATABASE_URL=postgresql://interviewlab:interviewlab_local@127.0.0.1:5433/interviewlab
# Optional interview-only local launcher; use a separate interviewlab_dev* database.
INTERVIEW_DEV_DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=3000
BODY_LIMIT_BYTES=1048576
WORKER_POLL_MS=1000
WORKER_HEARTBEAT_MS=5000
WORKER_STALE_MS=30000
# Server-only ChatECNU-compatible API; obtain your own token and never commit it.
LLM_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
LLM_MODEL=ecnu-plus
LLM_API_KEY=
LLM_OUTPUT_MODE=json_object
LLM_TIMEOUT_MS=25000
# Tests require a separately named database; never use personal or production data.
TEST_DATABASE_URL=postgresql://interviewlab:interviewlab_local@127.0.0.1:5433/interviewlab_test

# Separate public knowledge database (docker compose knowledge-postgres).
KNOWLEDGE_DATABASE_URL=postgresql://interviewlab:interviewlab_local@127.0.0.1:5434/interviewlab_knowledge
# Local draft content only; rejected in production. Formal releases require human review.
KNOWLEDGE_PREVIEW=false
EMBEDDING_MODEL=ecnu-embedding-small
